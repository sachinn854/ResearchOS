# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values:
#   cp .env.example .env
# Only the values marked REQUIRED must be set — everything else has a working
# default in backend/core/config.py.
# ---------------------------------------------------------------------------

# LLM — OpenRouter (REQUIRED)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Main model used for answer generation.
LLM_MODEL=openai/gpt-oss-120b
# Cheaper/faster model used for domain check, HyDE and entity extraction.
FAST_LLM_MODEL=openai/gpt-oss-20b:free
# Vision model used to describe images found inside PDFs.
VISION_LLM_MODEL=meta-llama/llama-3.2-11b-vision-instruct
# Optional: pin a specific OpenRouter provider e.g. Fireworks, Together, DeepInfra.
# Leave empty to let OpenRouter pick automatically.
# LLM_PROVIDER=

# Postgres (REQUIRED) — note the +asyncpg driver, the app is fully async
POSTGRES_URL=postgresql+asyncpg://postgres:password@localhost:5432/researchos

# Qdrant (REQUIRED)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=researchos_chunks
# Only needed for Qdrant Cloud, not for local Docker.
# QDRANT_API_KEY=

# Redis (REQUIRED) — used by Celery and the rate limiter
REDIS_URL=redis://localhost:6379

# Auth (REQUIRED)
# Signs the JWTs. Anyone with this value can mint a valid token for any account,
# so generate your own and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every issued token, i.e. signs everyone out.
JWT_SECRET_KEY=
# Token lifetime in minutes. Default 10080 = 7 days. There is no refresh token
# and no revocation list, so this is also how long a stolen token works.
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ingestion (optional)
# Entity extraction feeds the graph signal in hybrid retrieval. It costs one
# batched LLM call per 5 chunks. Set to false for faster, cheaper ingestion.
# ENABLE_ENTITY_EXTRACTION=true

# Web search fallback (optional)
# Without this key the "answer from the web when the KB is weak" path stays off.
# TAVILY_API_KEY=tvly-...

# LLM tracing (optional) — https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
